{
  "expo": {
    "name": "Compound",
    "slug": "compound",
    "scheme": "compound",
    "version": "1.7.0",
    "runtimeVersion": "2",
    "updates": {
      "requestHeaders": {
        "expo-channel-name": "main"
      },
      "url": "https://u.expo.dev/f33670b0-6e89-4a23-b379-ae0766832fa2"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "appleTeamId": "3264875TR6",
      "bundleIdentifier": "com.productivitybooster.app"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-dev-client",
      [
        "expo-audio",
        {
          "microphonePermission": "Compound uses the microphone so you can speak what you ate instead of typing it.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Compound reads a meal photo you pick to estimate its calories and protein.",
          "cameraPermission": "Compound uses the camera to photograph meals for calorie and protein estimates.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Compound uses the camera to scan food barcodes and photograph meals.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Compound reads your steps and workouts to automatically check off your daily goals.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f33670b0-6e89-4a23-b379-ae0766832fa2"
      }
    },
    "owner": "pradyumnaparsai",
    "android": {
      "permissions": [
        "android.permission.CAMERA"
      ]
    }
  }
}
